@model Leave_Management_System.Models.RoleMaster

@{
    ViewData["Title"] = "Edit Role";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6 offset-md-3">

            <form id="editRoleForm" method="post">
                @Html.AntiForgeryToken()

                <!-- Hidden ID -->
                <input type="hidden" asp-for="Id" value="@Model.Id" />

                <div class="card shadow">

                    <div class="card-header bg-warning text-center">
                        <h4><i class="fas fa-edit"></i> Edit Role</h4>
                    </div>

                    <div class="card-body">

                        <!-- Role Name -->
                        <div class="mb-3">
                            <label class="form-label required">Role Name</label>
                            <input asp-for="RoleName"
                                   class="form-control req"
                                   placeholder="Enter role name"
                                   data-error="Role name is required" />
                            <span asp-validation-for="RoleName" class="text-danger"></span>
                        </div>

                        <!-- Status -->
                        <div class="mb-3">
                            <label class="form-label required">Status</label>
                            <select asp-for="Status" class="form-select req">
                                <option value="ACTIVE">ACTIVE</option>
                                <option value="INACTIVE">INACTIVE</option>
                            </select>
                        </div>

                    </div>

                    <div class="card-footer d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Back</a>
                        <button type="submit" class="btn btn-warning">Update</button>
                    </div>

                </div>

            </form>

        </div>
    </div>
</div>
               
@section Scripts {
   
    <script>
        $(document).ready(function () {

            $('#editRoleForm').on('submit', function (e) {
                e.preventDefault();

                if (!$('#editRoleForm').length) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Form Error',
                            text: 'The form is not properly initialized. Please try again.',
                            confirmButtonText: 'OK'
                        });
                        return;
                 }
                         const isValid = $('#editRoleForm').universalValidate();
        if (!isValid) return;
                var formData = new FormData(this);

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("Edit", "RoleMaster")',
                    data: formData,
                    processData: false,
                    contentType: false,

                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Updated',
                                text: response.message
                            }).then(() => {
                                window.location.href = '@Url.Action("Index", "RoleMaster")';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message
                            });
                        }
                    },

                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong'
                        });
                    }
                });

            });

        });
    </script>
}