@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <!-- Info boxes -->
    <div class="row">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="info-box">
                <span class="info-box-icon bg-info elevation-1"><i class="fas fa-users"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Total Users</span>
                    <span class="info-box-number">
                        24
                        <small>users</small>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="info-box">
                <span class="info-box-icon bg-success elevation-1"><i class="fas fa-calendar-check"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Approved Leaves</span>
                    <span class="info-box-number">
                        12
                        <small>leaves</small>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="info-box">
                <span class="info-box-icon bg-warning elevation-1"><i class="fas fa-clock"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Pending Leaves</span>
                    <span class="info-box-number">
                        5
                        <small>leaves</small>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="info-box">
                <span class="info-box-icon bg-danger elevation-1"><i class="fas fa-calendar-times"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Rejected Leaves</span>
                    <span class="info-box-number">
                        2
                        <small>leaves</small>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Welcome Message -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Welcome to Leave Management System</h3>
        </div>
        <div class="card-body">
            <p>Hello <strong>@ViewBag.UserName</strong>! Welcome to the Leave Management System.</p>
            <p>Use the sidebar navigation to manage users and leave requests.</p>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Activity</h3>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th style="width: 30%">Employee</th>
                        <th style="width: 30%">Leave Type</th>
                        <th style="width: 20%">Status</th>
                        <th style="width: 20%">Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>John Smith</td>
                        <td>Sick Leave</td>
                        <td><span class="badge badge-success">Approved</span></td>
                        <td>Jun 3, 2026</td>
                    </tr>
                    <tr>
                        <td>Sarah Johnson</td>
                        <td>Annual Leave</td>
                        <td><span class="badge badge-warning">Pending</span></td>
                        <td>Jun 4, 2026</td>
                    </tr>
                    <tr>
                        <td>Mike Wilson</td>
                        <td>Personal Leave</td>
                        <td><span class="badge badge-success">Approved</span></td>
                        <td>Jun 2, 2026</td>
                    </tr>
                    <tr>
                        <td>Emily Davis</td>
                        <td>Sick Leave</td>
                        <td><span class="badge badge-danger">Rejected</span></td>
                        <td>Jun 1, 2026</td>
                    </tr>
                    <tr>
                        <td>David Brown</td>
                        <td>Annual Leave</td>
                        <td><span class="badge badge-warning">Pending</span></td>
                        <td>Jun 5, 2026</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
      

