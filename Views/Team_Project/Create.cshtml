@model Leave_Management_System.Models.Team_Project

@{
    ViewData["Title"] = "Create";
}

<div class="row">
    <div class="col-md-12">

        <form id="createForm" method="post">
            @Html.AntiForgeryToken()

            <div class="card shadow">
                <div class="card-header bg-primary text-center text-white">
                    <h4>Create</h4>
                </div>

                <div class="card-body">

                    <!-- Role Name -->
                    <div class="mb-3">
                        <label class="form-label required">Name</label>
                        <input asp-for="Name"
                               class="form-control req"
                               placeholder="Enter Name"
                               data-error="Name is required" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Back</a>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>

            </div>

        </form>

    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {

            $('#createForm').on('submit', function (e) {
                e.preventDefault();

            

                if (!$('#createForm').length) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Form Error',
                            text: 'The form is not properly initialized. Please try again.',
                            confirmButtonText: 'OK'
                        });
                        return;
                 }
                  const isValid = $('#createForm').universalValidate();
        if (!isValid) return;
                var formData = new FormData(this);

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("Create", "Team_Project")',
                    data: formData,
                    processData: false,
                    contentType: false,

                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message
                            }).then(() => {
                                window.location.href = '@Url.Action("Index", "Team_Project")';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message
                            });
                        }
                    },

                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong'
                        });
                    }
                });

            });

        });
    </script>
}