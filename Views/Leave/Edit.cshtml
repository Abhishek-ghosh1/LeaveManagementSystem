@model Leave_Management_System.Models.Leave

@{
    ViewData["Title"] = "Edit Leave";
   
}

                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12">

                            <form id="editLeaveForm" enctype="multipart/form-data" method="post">
                                @Html.AntiForgeryToken()

                                <!-- Hidden ID -->
                                <input type="hidden" asp-for="Id" value="@Model.Id" />

                                <div class="card">
                                    <div class="card-header bg-warning text-center">
                                        <span class="h3 fw-semibold">
                                            <i class="fas fa-edit"></i> Edit Leave Form
                                        </span>
                                    </div>

                                    <div class="card-body">

                                        <div class="row">

                                            <!-- Employee -->
                                            <div class="col-md-4 mb-3">
                                                <label class="required">Employee</label>
                                                <select asp-for="EmpUserID"
                                                        class="form-select req"
                                                        asp-items="Model.Employees">
                                                    <option value="">-- Select Employee --</option>
                                                </select>
                                            </div>

                                            <!-- Leave Reason -->
                                            <div class="col-md-4 mb-3">
                                                <label class="required">Reason for Leave</label>
                                                <select asp-for="LeaveReasonId"
                                                  class="form-select req" asp-items="Model.LeaveReasons">
                                                  <option value="">--Select Role--</option>
                                                </select>
                             
                                            </div>

                                            <!-- Description -->
                                            <div class="col-md-4 mb-3">
                                                <label class="required">Leave Description</label>
                                                <input type="text"
                                                       asp-for="LeaveDescription"
                                                       class="form-control req" />
                                            </div>

                                            <!-- Start Date -->
                                            <div class="col-md-4 mb-3">
                                                <label class="required">Start Date</label>
                                                <input type="date"
                                                       asp-for="StartDate"
                                                       class="form-control req" />
                                            </div>

                                            <!-- Join Date -->
                                            <div class="col-md-4 mb-3">
                                                <label class="required">Joining Date</label>
                                                <input type="date"
                                                       asp-for="JoinDate"
                                                       class="form-control req" />
                                            </div>

                                        </div>

                                        <!-- File Section -->
                                        <!-- Upload Files -->
                                        <fieldset class="border p-3 mb-4">
                                            <legend class="float-none w-auto p-2">Upload Files</legend>

                                            <div class="row g-3">


                                                <div class="form-group row mb-3">

                                                    <label class="col-sm-4 col-form-label required">
                                                        PDF File
                                                    </label>

                                                    <div class="col-sm-8">
                                                        @if (!string.IsNullOrEmpty(Model.UploadPDFFile))
                                                        {
                                                            var files = Model.UploadPDFFile
                                                            .Split(',', StringSplitOptions.RemoveEmptyEntries)
                                                            .Where(f => !string.IsNullOrWhiteSpace(f)).ToList();
                                                            @if (files.Any())
                                                            {
                                                                <div id="ExistingPdfFiles" class="d-flex flex-wrap justify-content-start gap-3 mb-2">
                                                                    @foreach (var file in files)
                                                                    {
                                                                        <div class="flex-shrink-0 image-wrapper" data-file="@file">
                                                                            @await Html.PartialAsync("_DocumentPreview", new DocumentPreviewViewModel
                                                                            {
                                                                                FileName = file,
                                                                                                            Path = $"~/uploads/Leave/{file}"
                                                                                                            })
                                                                </div>
                                                                                            }
                                                                    </div>
                                                                }

                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No pdf file uploaded</span>
                                                        }
                                                        <div class="custom-file">
                                                            <input type="file" class="form-control-file" data-error="Please Upload Pdfs." id="PDFFile" name="PDFFile" accept=".pdf">
                                                            <label for="PDFFile" class="custom-file-label" id="PdffileLabel">Choose pdf...</label>
                                                        </div>

                                                        <span id="fileError" class="text-danger"></span>
                                                        <div class="form-group col-md-12">
                                                            <div id="PdffilePreview" class="mt-2 d-flex flex-wrap">
                                                            </div>
                                                        </div>

                                                        <small class="form-text text-muted">
                                                            Allowed: Only PDF files
                                                        </small>

                                                    </div>
                                                </div>

                                                <div class="form-group row mb-3">
                                                    <label class="col-sm-4 col-form-label required">
                                                        Original File
                                                    </label>

                                                    <div class="col-sm-8">
                                                        @if (!string.IsNullOrEmpty(Model.OtherRelatedDocs))
                                                        {
                                                            var files = Model.OtherRelatedDocs
                                                            .Split(',', StringSplitOptions.RemoveEmptyEntries)
                                                            .Where(f => !string.IsNullOrWhiteSpace(f)).ToList();

                                                            @if (files.Any())
                                                            {
                                                                <div id="ExistingOrgFiles" class="d-flex flex-wrap justify-content-start gap-3 mb-2">
                                                                    @foreach (var file in files)
                                                                    {
                                                                        <div class="flex-shrink-0 image-wrapper" data-file="@file">
                                                                            @await Html.PartialAsync("_DocumentPreview", new DocumentPreviewViewModel
                                                                            {
                                                                                FileName = file,
                                                                                                            Path = $"~/uploads/Leave/{file}"
                                                                                                            })
                                                                </div>
                                                                                            }
                                                                </div>
                                                            }

                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No file uploaded</span>
                                                        }
                                                        <div class="custom-file">
                                                            <input type="file" class="form-control-file" data-error="Please Upload Images." accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.txt"
                                                                   id="OriginalFile" name="OtherDocs">
                                                            <label for="OriginalFile" class="custom-file-label" id="OrgfileLabel">Choose media...</label>
                                                        </div>
                                                        <span id="fileError" class="text-danger"></span>
                                                        <div class="form-group col-md-12">
                                                            <div id="OrgfilePreview" class="mt-2 d-flex flex-wrap">
                                                            </div>
                                                        </div>
                                                        <small class="form-text text-muted">
                                                            Allowed: Documents, Images, Archives (No videos).
                                                        </small>


                                                    </div>

                                                </div>

                                            </div>


                                        </fieldset>

                                    </div>

                                    <div class="card-footer d-flex justify-content-between">
                                        <a asp-action="Index" class="btn btn-secondary">Back</a>
                                        <div>
                                            <button type="submit" id="btnDraft" class="btn btn-warning me-2">
                                                <i class="fas fa-save"></i> Save as Draft
                                            </button>
                                            <button type="submit" id="btnSubmit" class="btn btn-info">
                                                <i class="fas fa-paper-plane"></i> Update
                                            </button>
                                        </div>
                                    </div>

                                </div>
                            </form>

                        </div>
                    </div>
                </div>
           

<!-- Image Preview Modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title" id="imagePreviewLabel">Document Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="previewImage" src="" class="img-fluid rounded shadow" alt="Preview" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
  
     <script>
            // Image click to show modal preview
        $(document).on('click', '.img-thumbnail', function () {
            const src = $(this).attr('src');
            $('#previewImage').attr('src', src);
            const modal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
            modal.show();
        });
    </script>
    <script>
        let actionType = "";
        let isSubmitting = false;

        $(document).ready(function () {
            setupFilePreview('#OriginalFile', '#OrgfilePreview', '#fileError', 10, 10);
            setupFilePreview('#PDFFile', '#PdffilePreview', '#fileError', 10, 10);

            // Identify which button was pressed
            $('#btnSubmit').on('click', function () {
                actionType = 'submit';
            });

            $('#btnDraft').on('click', function () {
                actionType = 'draft';
            });

            $('#editLeaveForm').on('submit', function (e) {
                e.preventDefault();

                if (isSubmitting) return; // Prevent double submission
                isSubmitting = true;

                if (!$('#editLeaveForm').length) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Form Error',
                        text: 'The form is not properly initialized. Please try again.',
                        confirmButtonText: 'OK'
                    });
                    isSubmitting = false;
                    return;
                }

                const isValid = $('#editLeaveForm').universalValidate();
                if (!isValid) {
                    isSubmitting = false;
                    return;
                }

                $('#modal-loader').modal('show');

                var formData = new FormData(this);
                
                // Add the action type to form data
                if (actionType) {
                    formData.append('submitType', actionType);
                }

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("Edit", "Leave")',
                    data: formData,
                    processData: false,
                    contentType: false,

                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Updated',
                                text: response.message
                            }).then(() => {
                                window.location.href = '@Url.Action("Index", "Leave")';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message
                            });
                        }
                    },

                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong'
                        });
                    }
                   
                });

            });

        });
    </script>

}
