@model Leave_Management_System.Models.Users

@{
    ViewData["Title"] = "Edit User";
}

<div class="container">
    <div class="card">

        <div class="card-header bg-primary text-center">
            <h4 class="m-0 text-white">Edit User</h4>
        </div>
        <div class="card-body">
            <form id="editUserForm" asp-action="Edit" method="post">

                <!-- Hidden ID -->
                <input type="hidden" asp-for="Id" value="@Model.Id" />

                <div class="form-group">
                    <label>Name</label>
                    <input asp-for="Name" class="form-control req" />
                </div>

                <div class="form-group">
                    <label>Pin No</label>
                    <input asp-for="PinNo" class="form-control req" />
                </div>

                <div class="form-group">
                    <label>Team/Project</label>
                    <select asp-for="Team_ProjectIds" class="form-control req select2" data-error="Required" asp-items="Model.Team_Projects" multiple>
                        <option value="">--Select Team/Project--</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Role</label>
                    <select asp-for="RoleId" class="form-control req select2" data-error="Role is Required" asp-items="Model.Roles">
                       <option value="">--Select Role--</option>
                   </select>
                </div> 

                <div class="form-group">
                    <label>Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter new password (optional)" />
                </div>

                <div class="form-group">
                    <label>Status</label>
                    <select asp-for="Status" class="form-control req">
                        
                        <option value="ACTIVE">ACTIVE</option>
                        <option value="INACTIVE">INACTIVE</option>
                    </select>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-block">Save Changes</button>
                </div>
                             
            </form>
        </div>

        <div class="card-footer">
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>

    </div>
</div>
          
@section Scripts {
    
    <script>
        $(document).ready(function () {

               $('.select2').select2({
            width: '100%'
        });


            $('#editUserForm').on('submit', function (e) {
                e.preventDefault();

                 if (!$('#editUserForm').length) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Form Error',
                            text: 'The form is not properly initialized. Please try again.',
                            confirmButtonText: 'OK'
                        });
                        return;
                 }

                const isValid = $('#editUserForm').universalValidate();
                if (!isValid) return;

                var form = this;
                var formData = new FormData(form);

                $('#modal-loader').modal('show');

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("Edit", "Users")',
                    data: formData,
                    processData: false,
                    contentType: false,

                    success: function (response) {

                        $('#modal-loader').modal('hide');

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Updated',
                                text: response.message
                            }).then(() => {
                                window.location.href = '@Url.Action("Index", "Users")';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message
                            });
                        }
                    },

                    error: function () {

                        $('#modal-loader').modal('hide');

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong'
                        });
                    }
                });
            });

        });
    </script>
}