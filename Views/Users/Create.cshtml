@model Leave_Management_System.Models.Users

@{
    ViewData["Title"] = "Create User";
}

<div class="container">
    <div class="card">

        <div class="card-header bg-primary text-center">
            <h4 class="m-0 text-white">Create User</h4>
        </div>

        <div class="card-body">
            <form id="createUserForm" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="form-group mb-3">
                    <label>Name</label>
                    <input asp-for="Name" class="form-control req" />
                </div>

                <div class="form-group mb-3">
                    <label>Contact No</label>
                    <input asp-for="ContactNo" class="form-control" type="tel" />
                </div>

                <div class="form-group mb-3">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" type="email" />
                </div>

                <div class="form-group mb-3">
                    <label>Address</label>
                    <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                </div>

                <div class="form-group mb-3">
                    <label>Team/Project</label>
                    <select asp-for="Team_ProjectIds"
                            class="form-control req select2"
                            data-error="This is Required"
                            asp-items="Model.Team_Projects" multiple>
                        <option value="">--Select Team/Project--</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label>Role</label>
                    <select asp-for="RoleId"
                            class="form-control req select2"
                            data-error="This is Required"
                            asp-items="Model.Roles">
                        <option value="">--Select Role--</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label>Total No. Of Leaves </label>
                    <input asp-for="TotalNoofLeaves" class="form-control req" />
                </div>

                <div class="form-group mb-3">
                    <label>Pin No</label>
                    <input asp-for="PinNo" class="form-control req" />
                </div>

                <div class="form-group mb-3">
                    <label>Password</label>
                    <input asp-for="Password" type="password" class="form-control req" />
                </div>

                <div class="form-group mb-3">
                    <label>Status</label>
                    <select asp-for="Status" class="form-control req">
                        <option value="">--Select Status--</option>
                        <option value="ACTIVE">ACTIVE</option>
                        <option value="INACTIVE">INACTIVE</option>
                    </select>
                </div>
             
                <div class="form-group mb-3">
                    <label>User Image</label>

                    <div class="col-sm-8">

                        <div class="custom-file">
                            <input type="file" class="form-control-file" data-error="Please Upload Images." accept=".jpg,.jpeg,.png"
                                   id="ProfilePic" name="ProfilePic">
                            <label for="ProfilePic" class="custom-file-label" id="OrgfileLabel">Choose media...</label>
                        </div>
                        <span id="fileError" class="text-danger"></span>
                        <div class="form-group col-md-12">
                            <div id="ProfilePicPreview" class="mt-2 d-flex flex-wrap">
                            </div>
                        </div>
                        <small class="form-text text-muted">
                            Allowed: Images (No videos).
                        </small>
                    </div>

                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary w-100">Create</button>
                </div>

            </form>
        </div>

        <div class="card-footer">
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>

    </div>
</div>
@section Scripts {
   
    <script>
        $(document).ready(function () {
                   
            $('.select2').select2({
            width: '100%'

        });

         setupFilePreview('#ProfilePic', '#ProfilePicPreview', '#fileError', 10, 10);

            $('#createUserForm').on('submit', function (e) {
                e.preventDefault();

                if (!$('#createUserForm').length) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Form Error',
                            text: 'The form is not properly initialized. Please try again.',
                            confirmButtonText: 'OK'
                        });
                        return;
                 }

                // Validation
                const isValid = $('#createUserForm').universalValidate();
                if (!isValid) return;

                var form = this;
                var formData = new FormData(form);
             
                $('#modal-loader').modal('show');

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("Create", "Users")', 
                    data: formData,
                    processData: false,
                    contentType: false,

                    success: function (response) {

                        $('#modal-loader').modal('hide');

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message
                            }).then(() => {
                                window.location.href = '@Url.Action("Index", "Users")'; 
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message
                            });
                        }
                    },

                    error: function () {
                        $('#modal-loader').modal('hide');

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong'
                        });
                    }
                });
            });

        });
    </script>
}
