@model Leave_Management_System.Models.Users

@{
    ViewData["Title"] = "User Details";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
    <div class="card">

        <div class="card-header bg-primary text-center">
            <h4 class="m-0 text-white">Detail </h4>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-md-3"><strong>Name</strong></div>
                <div class="col-md-8">@Model.Name</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Contact No</strong></div>
                <div class="col-md-8">@Model.ContactNo</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Email</strong></div>
                <div class="col-md-8">@Model.Email</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Address</strong></div>
                <div class="col-md-8">@Model.Address</div>
            </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-4 col-form-label required">
                            Image
                        </label>

                        <div class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                var files = Model.Image
                                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                                .Where(f => !string.IsNullOrWhiteSpace(f)).ToList();

                                @if (files.Any())
                                {
                                    <div id="ExistingOrgFiles" class="d-flex flex-wrap justify-content-start gap-3 mb-2">
                                        @foreach (var file in files)
                                        {
                                            <div class="flex-shrink-0 image-wrapper" data-file="@file">
                                                @await Html.PartialAsync("_DocumentPreview", new DocumentPreviewViewModel
                                                {
                                                    FileName = file,
                                                                        Path = $"~/uploads/Users/{file}"
                                                                        })
                                </div>
                                                                }
                                    </div>
                                }

                            }
                            else
                            {
                                <span class="text-muted">No file uploaded</span>
                            }
                          
                        </div>
                    </div>
            <div class="row mb-2">
                <div class="col-md-3"><strong>User ID</strong></div>
                <div class="col-md-8">@Model.PinNo</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Total No. Of Leaves</strong></div>
                <div class="col-md-8">@Model.TotalNoofLeaves</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Team Name</strong></div>
                        <div class="col-md-8">


                            @foreach (var name in ViewBag.Team_ProjectName)
                                {
                                    <span class="badge bg-primary me-1">@name</span>
                                }
                            
                        </div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Role Name</strong></div>
                <div class="col-md-8">@ViewBag.RoleName</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Status</strong></div>
                <div class="col-md-8">
                    <span class="badge @(Model.Status == "ACTIVE" ? "bg-success" :"bg-danger" )">
                        @Model.Status
                    </span>
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Created By</strong></div>
                <div class="col-md-8">@ViewBag.CreatedBy</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Created Date</strong></div>
                <div class="col-md-8">
                    @Model.CreatedDatetime.ToString("dd-MM-yyyy HH:mm")
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Updated By</strong></div>
                <div class="col-md-8">
                    @(Model.UpdatedBy.HasValue? ViewBag.UpdatedBy.ToString() : "N/A")
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3"><strong>Updated Date</strong></div>
                <div class="col-md-8">
                    @(Model.UpdatedDatetime.HasValue
                                        ? Model.UpdatedDatetime.Value.ToString("dd-MM-yyyy HH:mm")
                                        : "N/A")
                </div>
            </div>

        </div>
    </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>

             
           